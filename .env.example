# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

# ── YouTube Data API ──────────────────────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials.
# Enable "YouTube Data API v3" before generating the key.
YOUTUBE_API_KEY=

# ── Ingestion Settings ────────────────────────────────────────────────────────
# Maximum number of videos tracked simultaneously per channel.
MAX_VIDEOS_PER_CHANNEL=10

# Hard cap on total active tracked videos per channel. When exceeded after
# discovery, the oldest videos (by published_at) are evicted to stay at this limit.
MAX_TRACKED_PER_CHANNEL=100

# How far back (in days) to look for eligible videos per channel.
# Videos already tracked that fall outside this window are also evicted on discovery.
VIDEO_LOOKBACK_DAYS=30

# Hours without a new comment before a video is evicted from the tracked list
# and replaced with a fresh candidate from the same channel.
COMMENT_INACTIVITY_HOURS=24

# Maximum number of comments fetched and published per video per poll run.
# Caps backfill cost for newly tracked videos with large comment histories.
MAX_COMMENTS_PER_POLL=2000

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Use kafka:9092 when running inside Docker (default).
# Use localhost:9094 when running the ingestion service directly on the host.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Apicurio Schema Registry ──────────────────────
SCHEMA_REGISTRY_URL=http://schema-registry:8080/apis/ccompat/v7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# Airflow metadata database (created automatically by the postgres Docker image)
AIRFLOW_DB=airflow

# Ingestion state database (tracks active videos & last-comment timestamps)
INGESTION_DB=ingestion

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123    # Used by dashboards and ad-hoc queries
CLICKHOUSE_NATIVE_PORT=9000  # Used by Flink and Spark ClickHouse connectors
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin

# ── Flink Stream Processing ───────────────────────────────────────────────────
# Number of parallel task slots for the sentiment analysis job.
FLINK_PARALLELISM=2

# Number of threads used by ONNX Runtime inference (per task slot).
OMP_NUM_THREADS=2

# ── Video Downloader ──────────────────────────────────────────────────────────
# Days to look back when computing per-video satisfaction from comments.
DOWNLOAD_LOOKBACK_DAYS=7

# Number of top-satisfaction videos to download per run.
TOP_VIDEOS_TO_DOWNLOAD=5

# Minimum comment count a video must have to be eligible for download.
MIN_COMMENTS_FOR_DOWNLOAD=50

# Maximum video height (resolution) to download. Common values: 720, 1080, 1440, 2160.
VIDEO_MAX_HEIGHT=720

# ── MinIO (Object Storage for downloaded videos) ───────────────────────────────
# Use minio:9000 when running inside Docker (default).
# Use localhost:9002 when running the downloader directly on the host
# (host port 9002 maps to container port 9000; 9000 is taken by ClickHouse).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_VIDEOS_BUCKET=videos

# ── Airflow ───────────────────────────────────────────────────────────────────
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Default admin credentials created by the airflow-init container on first start
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
