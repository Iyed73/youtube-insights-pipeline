# Google Cloud Console → APIs & Services → Credentials, with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=

MAX_VIDEOS_PER_CHANNEL=10

# When exceeded after discovery, the oldest videos (by published_at) are evicted.
MAX_TRACKED_PER_CHANNEL=100

# Tracked videos older than this window are evicted on discovery.
VIDEO_LOOKBACK_DAYS=30

COMMENT_INACTIVITY_HOURS=24

# Caps backfill cost for newly tracked videos with large comment histories.
MAX_COMMENTS_PER_POLL=2000

# Use localhost:9094 when running the ingestion service directly on the host.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

SCHEMA_REGISTRY_URL=http://schema-registry:8080/apis/ccompat/v7

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
AIRFLOW_DB=airflow
INGESTION_DB=ingestion

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin

FLINK_PARALLELISM=2
# ONNX Runtime inference threads per task slot.
OMP_NUM_THREADS=2

DOWNLOAD_LOOKBACK_DAYS=7
TOP_VIDEOS_TO_DOWNLOAD=5
MIN_COMMENTS_FOR_DOWNLOAD=50
VIDEO_MAX_HEIGHT=720

# Use localhost:9002 when running the downloader directly on the host.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_VIDEOS_BUCKET=videos

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
